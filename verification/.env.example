# OpenAI API key (get it on platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the API base url (leave commented out to use the official OpenAI API)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model used as the judge (eg. gpt-5-mini, gpt-5, gpt-4.1-mini)
MODEL=gpt-5-mini

# How many randomly sampled examples to verify
NUM_EXAMPLES=30

# Random seed for sampling (the same seed picks the same examples)
SEED=42

# Maximum number of concurrent requests to the API
MAX_CONCURRENCY=5

# debug mode (true/false) - prints the dataset solution and the raw model reply for every example
DEBUG=false
