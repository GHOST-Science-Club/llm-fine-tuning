HF_TOKEN=your_hf_token
HF_USER=your_hf_username
WANDB_API_KEY=your_api_key
PUSH_TO_HUB=false
LOG_TO_WANDB=false
MAX_TRAIN_SAMPLES=1000

# --- TPU-specific ---
# FSDPv2/SPMD sharding across TPU chips. Required for Bielik-11B if it does not fit on a single chip.
USE_FSDP_V2=true
# Decoder-layer class to shard on (Bielik is Mistral-based)
FSDP_LAYER_CLS=MistralDecoderLayer

# --- Smoke-test overrides (uncomment to test without the grant, see README) ---
# BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# FSDP_LAYER_CLS=Qwen2DecoderLayer
# USE_FSDP_V2=false
# MAX_SEQUENCE_LENGTH=256
# TRAIN_BATCH_SIZE=2
# MAX_TRAIN_SAMPLES=32
# SAVE_STEPS=2
# LOG_STEPS=1
# VAL_SIZE=8
