# Grant number
GRANT=plXXXX-XX

# User name in the PCSS system 
USER=<user_name>

HF_TOKEN=...
# PCSS api key (not needed if using vllm)
API_KEY=not-needed

# PCSS api base url
# If not using api, set to http://localhost:8080/v1
API_BASE_URL=https://llm.hpc.psnc.pl/v1

# Name of model (eg. llama-3-8b)
MODEL=Qwen/Qwen3.8-27B

# debug mode (true/false)
DEBUG=true

# Whether to load the processed data from Hugging Face Hub (true/false)
LOAD_FROM_HUB=false

# Whether to push the processed data to Hugging Face Hub (true/false)
PUSH_TO_HUB=false

# Whether to save logs (true/false)
SAVE_LOGS=false

# Maximum number of concurrent requests to the API
MAX_CONCURRENCY=32
# Number of samples to process in each batch
BATCH_SIZE=128

# Hugging Face Hub dataset to read from when LOAD_FROM_HUB=true
HUB_DATASET_SOURCE=meta-math/MetaMathQA

# Hugging Face Hub dataset (repo id) to push to when PUSH_TO_HUB=true
HUB_DATASET_DESTINATION=erybie222/test

# Local input file, relative to data_dir (or an absolute path)
INPUT_FILE=input/forum_example_fixed.jsonl

# Local output file, relative to data_dir (or an absolute path)
OUTPUT_FILE=output/pipeline_output.jsonl